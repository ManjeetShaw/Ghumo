# URL of the real backend (Backend_Codebase). /api/* requests are proxied here
# by server.ts (dev + production) and by Vite when using `npm run dev:vite`.
BACKEND_URL=http://localhost:5000

# Optional: only if you host the frontend statically and want the browser to
# call the backend directly instead of through the proxy. Baked in at build time.
# VITE_API_URL=https://api.yourdomain.com/api
