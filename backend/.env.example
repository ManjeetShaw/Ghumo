# Copy to backend/.env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/ghumo
REDIS_URL=redis://127.0.0.1:6379

# Required in production. Use a long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API in production, comma separated.
# Not needed when the frontend server proxies /api (same origin).
CORS_ORIGINS=

# Razorpay (test keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gemini, used for plain language search and the trip planner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Travel data providers. Leave empty to use the built in sample data.
RAILRADAR_API_KEY=
AVIATIONSTACK_API_KEY=
